generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING_CONFIRMATION
  ORDER_RECEIVED
  ORDER_ACCEPTED
  ORDER_READY
  ORDER_DELIVERING
  ORDER_DELIVERED
  CANCELLED
}

enum Source {
  WHATSAPP
  IFOOD
  NINETY_NINE
}

enum InboundEventStatus {
  RECEIVED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
  DUPLICATE
}

enum WaMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppConversationState {
  NEEDS_NAME
  NEEDS_ADDRESS
  READY_TO_ORDER
  WAITING_ORDER_ITEMS
  PENDING_CONFIRMATION
}

enum ProductExternalSource {
  FIREBIRD
  MSSQL
  MANUAL
  UNKNOWN
}

enum LegacyConnectionSource {
  FIREBIRD
  MSSQL
}

enum LegacyExportSource {
  FIREBIRD
  MSSQL
  MOCK
}

enum LegacyExportAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum ClientPushAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum UserRole {
  OWNER
  ADMIN
  MODERATOR
  USER
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
  PAST_DUE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique @map("api_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customers             Customer[]
  orders                Order[]
  orderItems            OrderItem[]
  inboundEvents         InboundEvent[]
  orderStatusHistory    OrderStatusHistory[]
  whatsAppMessages      WhatsAppMessage[]
  products              Product[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppAccounts      WhatsAppAccount[]
  comandaIntegrationLogs ComandaIntegrationLog[]
  legacyConnectionConfigs LegacyConnectionConfig[]
  legacyExportAttempts LegacyExportAttempt[]
  clientPushAttempts    ClientPushAttempt[]
  tenantUsers           TenantUser[]
  clientMappingConfig   ClientMappingConfig?
  subscription          Subscription?

  @@map("tenants")
}

model WhatsAppAccount {
  id                String   @id @default(uuid())
  tenantId          String   @unique @map("tenant_id")
  accountSid        String   @map("account_sid")
  authToken         String   @map("auth_token")
  whatsappFrom      String   @map("whatsapp_from")
  sandboxJoinCode   String?  @map("sandbox_join_code")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([accountSid])
  @@index([whatsappFrom])
  @@map("whatsapp_accounts")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  phone     String
  name      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders               Order[]
  whatsAppConversations WhatsAppConversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("customers")
}

model Order {
  id               String      @id @default(uuid())
  tenantId         String      @map("tenant_id")
  customerId       String?     @map("customer_id")
  source           Source
  externalOrderId  String      @map("external_order_id")
  status           OrderStatus @default(PENDING_CONFIRMATION)
  total            Decimal     @default(0) @db.Decimal(12, 2)
  rawPayload       Json        @default("{}") @map("raw_payload")
  metadata         Json        @default("{}")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  legacyExportAttempts LegacyExportAttempt[]
  clientPushAttempts ClientPushAttempt[]

  @@unique([tenantId, source, externalOrderId])
  @@index([tenantId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  orderId    String   @map("order_id")
  name       String
  quantity   Int      @default(1)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(12, 2)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

model InboundEvent {
  id               String             @id @default(uuid())
  tenantId         String             @map("tenant_id")
  source           Source
  externalEventId  String             @map("external_event_id")
  payload          Json               @default("{}")
  status           InboundEventStatus @default(RECEIVED)
  errorMessage     String?            @map("error_message")
  processedAt      DateTime?          @map("processed_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, externalEventId])
  @@index([tenantId])
  @@index([status])
  @@map("inbound_events")
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  orderId        String       @map("order_id")
  previousStatus OrderStatus? @map("previous_status")
  status         OrderStatus
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@map("order_status_history")
}

model WhatsAppMessage {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  phone        String
  direction    WaMessageDirection
  messageText  String             @map("message_text")
  rawPayload   Json               @default("{}") @map("raw_payload")
  createdAt    DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phone])
  @@map("whatsapp_messages")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  displayCode String   @map("display_code")
  name        String
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  externalId     String?               @map("external_id")
  externalSource ProductExternalSource @default(UNKNOWN) @map("external_source")
  lastSyncedAt   DateTime?             @map("last_synced_at")
  syncMetadata   Json?                 @map("sync_metadata")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, displayCode])
  @@index([tenantId])
  @@map("products")
}

model WhatsAppConversation {
  id         String                     @id @default(uuid())
  tenantId   String                     @map("tenant_id")
  phone      String
  customerId String                     @map("customer_id")
  state      WhatsAppConversationState  @default(NEEDS_NAME)
  address    String?
  createdAt  DateTime                   @default(now()) @map("created_at")
  updatedAt  DateTime                   @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
  @@index([customerId])
  @@map("whatsapp_conversations")
}

model ComandaIntegrationLog {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  payload      Json     @default("{}")
  result       Json     @default("{}")
  status       String
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("comanda_integration_logs")
}

model LegacyConnectionConfig {
  id           String                 @id @default(uuid())
  tenantId     String                 @map("tenant_id")
  source       LegacyConnectionSource
  host         String
  port         Int
  databaseName String                 @map("database_name")
  username     String
  password     String
  options      Json                   @default("{}")
  enabled      Boolean                @default(false)
  dryRun       Boolean                @default(true) @map("dry_run")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source])
  @@index([tenantId, enabled])
  @@map("legacy_connection_configs")
}

model LegacyExportAttempt {
  id               String                    @id @default(uuid())
  tenantId         String                    @map("tenant_id")
  orderId          String                    @map("order_id")
  source           LegacyExportSource
  idempotencyKey   String                    @map("idempotency_key")
  payload          Json                      @default("{}")
  status           LegacyExportAttemptStatus @default(PENDING)
  attemptCount     Int                       @default(0) @map("attempt_count")
  lastError        String?                   @map("last_error")
  providerResponse Json?                     @map("provider_response")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId, source])
  @@index([tenantId, status, updatedAt])
  @@map("legacy_export_attempts")
}

model ClientPushAttempt {
  id           String                  @id @default(uuid())
  tenantId     String                  @map("tenant_id")
  orderId      String                  @map("order_id")
  status       ClientPushAttemptStatus @default(PENDING)
  attemptCount Int                     @default(0) @map("attempt_count")
  lastError    String?                 @map("last_error")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, orderId])
  @@index([tenantId, status, updatedAt])
  @@map("client_push_attempts")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now()) @map("created_at")

  tenants TenantUser[]

  @@map("users")
}

model TenantUser {
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId, role])
  @@map("tenant_users")
}

model ClientMappingConfig {
  tenantId  String   @id @map("tenant_id")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("client_mapping_configs")
}

model Subscription {
  tenantId             String             @id @map("tenant_id")
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(TRIAL)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  usageCount           Int                @default(0) @map("usage_count")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, plan])
  @@map("subscriptions")
}
