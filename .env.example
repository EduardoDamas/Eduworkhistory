NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://app:app@localhost:5432/order_platform?schema=public

# Redis for BullMQ (must allow BullMQ/ioredis settings)
REDIS_URL=redis://localhost:6379

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# BullMQ key prefix (helps isolate queues per environment)
QUEUE_PREFIX=order-platform

# WhatsApp outbound mode: mock | cloud
WHATSAPP_SEND_MODE=mock

# Meta Graph API version used for Cloud API send endpoint
WHATSAPP_GRAPH_API_VERSION=v20.0

# Enforce X-Hub-Signature-256 webhook validation when app_secret is configured
WHATSAPP_REQUIRE_SIGNATURE=false

# Legacy export mode: mock | dry-run | live
LEGACY_EXPORT_MODE=mock

# Connection / request timeout (ms) for live Firebird/MSSQL connectors
LEGACY_DB_TIMEOUT_MS=15000

# Retry settings for legacy-export queue
LEGACY_EXPORT_RETRY_ATTEMPTS=5
LEGACY_EXPORT_RETRY_BACKOFF_MS=3000
