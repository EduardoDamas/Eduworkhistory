{
  "name": "restaurant-order-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant restaurant order platform — Phase 1 foundation",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "tsc --noEmit",
    "test:twilio-whatsapp": "tsx scripts/test-twilio-whatsapp.ts",
    "test:ifood-auth": "tsx scripts/test-ifood-auth.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bullmq": "^5.47.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mssql": "^11.0.1",
    "node-firebird": "^1.1.10",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.14.1",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
